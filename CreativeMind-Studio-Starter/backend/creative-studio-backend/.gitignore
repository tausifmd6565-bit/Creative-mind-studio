# ==============================================================================
# Backend .gitignore
# ==============================================================================

# Secrets & Local Configs
.env
.env.*
!.env.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/

# Package & Build Artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs & Temporary outputs
*.log
test_output.txt

# Databases
*.db
*.sqlite
*.sqlite3

# IDE / OS junk
.DS_Store
.vscode/
.idea/
