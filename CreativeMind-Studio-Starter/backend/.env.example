# ==============================================================================
# CreativeMind Studio — Backend Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ==============================================================================

# Active AI Provider Options: groq | openai | grok | replicate | watsonx
AI_PROVIDER=groq

# Groq API Key (Free & High Speed Tier — https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Grok / OpenAI API Key (Optional)
OPENAI_API_KEY=
GROK_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Connection String (Supabase / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application Settings
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_VERSION=0.1.0
